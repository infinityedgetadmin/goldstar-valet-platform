{
  "name": "goldstar-platform-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "lint": "eslint src",
    "type-check:tests": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage --project demo-goldstar",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@goldstar/platform": "file:vendor/goldstar-platform-0.4.12.tgz",
    "@google-cloud/secret-manager": "^7.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^8.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.0.0",
    "ical.js": "^2.2.1",
    "pdfkit": "^0.20.1",
    "resend": "^6.24.0",
    "stripe": "^19.3.0",
    "twilio": "^6.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "adm-zip": "^0.6.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
